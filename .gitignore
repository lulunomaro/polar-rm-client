# =============================================================================
# POLAR-RM (rm_custom_client) — Git ignore rules
# Repo: https://github.com/lulunomaro/polar-rm-client
# Only infrastructure; does not change application source.
# =============================================================================

# --- Python env / bytecode ---
.venv/
# Exact Linux verification environment documented in docs/quality_gates.md
/.venv-verification/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local editor / agent scratch ---
.claude/
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Runtime caches (regenerable) ---
.wallpaper_cache/
*.log

# --- Temp / debug render dumps (do not version) ---
tmp_render_checks/
tmp_selfcheck/
tmp_*/
# 本机跑 golden / 编译体检时留下的抓帧日志与源码快照，别让 git add -A 顺手带走
_golden_out.txt
kernel.errors.txt
tmp_*.zip
tmp_*.json
_backup_*/

# --- Release archives (large; rebuild with tools/build_release.ps1) ---
release/*.zip
release/**/*.zip

# --- User-imported wallpapers (local only) ---
assets/wallpapers/user/

# --- Imported video wallpapers stay local; reviewed built-ins are versioned ---
assets/wallpapers/**/*.mp4
assets/wallpapers/**/*.webm
assets/wallpapers/**/*.mov
assets/wallpapers/**/*.mkv
assets/wallpapers/**/*.avi
!assets/wallpapers/builtin/texas.mp4
!assets/wallpapers/builtin/vending-machine.mp4

# --- Machine-local calibration data ---
calibrations/*
!calibrations/.gitkeep

# --- Optional: ignore entire unpacked release tree under release/ ---
release/POLAR-RM_Custom_Client_*/

# Portable runtime state / qualification evidence (never source controlled)
field_evidence/
logs/
user_data/
build/
dist/
*.spec.bak
_pdf_extract.txt

# Local environments and user-imported audio
.venv-polar/
.venv-polar.broken-*/
assets/ui_sounds/custom/*
!assets/ui_sounds/custom/.gitkeep

# Root scratch workspaces and temporary files (do not hide fixtures or evidence)
/tmp*/
/temp/
/.tmp/
/tmp_*
/_tmp_*
*.tmp
*.temp

# Generated GPU smoke screenshot; intentional visual baselines stay tracked
/tests/_gpu_renderer_runtime.png
